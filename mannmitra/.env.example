# Copy to .env and export the values (or set them in your shell). Nothing here is required for offline mode.
MANNMITRA_PROVIDER=gemini         # gemini | offline | anthropic | watsonx
MANNMITRA_SALT=change-this-to-a-long-random-string
MANNMITRA_DB=mannmitra.db
MANNMITRA_ADMIN_TOKEN=            # set to enable /api/dashboard?token=...

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# IBM watsonx.ai  (pip install ibm-watsonx-ai)
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Telegram
TELEGRAM_BOT_TOKEN=
