MANNMITRA_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-Google-AI-Studio-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (required for persistent storage on Vercel)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MANNMITRA_SALT=replace-with-a-long-random-string
MANNMITRA_ADMIN_TOKEN=replace-with-a-separate-long-random-token

MANNMITRA_DB=data/mannmitra.sqlite3
