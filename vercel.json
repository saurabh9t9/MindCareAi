{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "app.py": {
          "maxDuration": 60,
          "includeFiles": "public/static/**"
        }
      }
    },
    "mannmitra": {
      "root": "mannmitra",
      "runtime": "python",
      "entrypoint": "vercel_app:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
